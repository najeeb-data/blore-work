rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Anyone can view images (so jobs/clients can see them)
    // Only logged-in users can upload, and files must be < 5MB and an image
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null 
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
